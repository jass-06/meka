# HuggingFace token - required (embeddings + image captioning)
# Get one at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Groq API key - optional, enables cloud "assist" mode + HyDE
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# API key required to call the FastAPI service (api.py). Leave blank to
# disable auth for local dev; set a real value before deploying.
MEKA_API_KEY=

# Ollama (local LLM fallback) - defaults assume `ollama serve` on localhost
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./chroma_db
COLLECTION_NAME=enterprise_knowledge
DATA_DIR=data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
